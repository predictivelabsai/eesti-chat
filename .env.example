# --- LLM provider ---
LLM_PROVIDER=xai
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4-1-fast-reasoning
# XAI_AGENT_MODEL=            # optional override for agent LLM
# XAI_VOICE=eve               # speech-to-speech voice; uses XAI_API_KEY (eve, ara, rex, sal, leo)
# XAI_VOICE_MODEL=grok-voice-latest
# OPENAI_API_KEY=            # used when LLM_PROVIDER=openai
# OPENAI_MODEL=gpt-4o

# --- Grounding (web search) ---
EXA_API_KEY=

# --- App ---
APP_SECRET=change-me
SERVICE_URL=https://eesti.chat
PORT=5011
LOGIN=0                       # set 1 to require login for chat
# DB_URL=postgresql+psycopg2://user:pass@localhost:5432/eesti   # optional

# --- Authentication and email ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=                   # optional; falls back to APP_SECRET
POSTMARK_API_TOKEN=
FROM_EMAIL=info@eesti.chat
FROM_NAME=eesti.chat
TO_EMAIL=

# --- MCP-backed agent tools (chat app) ---
# Remote MCP server; leave empty to run the MCP tools in-process.
# EESTI_MCP_URL=https://mcp.eesti.chat/mcp
# EESTI_MCP_API_KEY=

# --- MCP server (mcp_server/, Dockerfile.mcp) ---
# MCP_PORT=8000
# MCP_DATA_DIR=/data
# MCP_API_KEY_HASHES=        # comma-separated sha256 hashes: python -m mcp_server.keys new
# MCP_ANON_RPM=30
# MCP_ANON_RPD=500
# MCP_KEY_RPM=300
# MCP_KEY_RPD=20000
# MCP_BULK_AUTOLOAD=1
