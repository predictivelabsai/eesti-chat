# --- LLM provider ---
LLM_PROVIDER=xai
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4-1-fast-reasoning
# XAI_AGENT_MODEL=            # optional override for agent LLM
# OPENAI_API_KEY=            # used when LLM_PROVIDER=openai
# OPENAI_MODEL=gpt-4o

# --- Grounding (web search) ---
EXA_API_KEY=

# --- App ---
APP_SECRET=change-me
SERVICE_URL=https://eesti.chat
PORT=5011
LOGIN=0                       # set 1 to require login for chat
# DB_URL=postgresql+psycopg2://user:pass@localhost:5432/eesti   # optional

# --- Authentication and email ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=                   # optional; falls back to APP_SECRET
POSTMARK_API_TOKEN=
FROM_EMAIL=info@eesti.chat
FROM_NAME=eesti.chat
TO_EMAIL=
